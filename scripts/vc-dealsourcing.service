[Unit]
Description=VC Dealsourcing FastAPI Backend
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/dealsourcing_agent/backend
Environment="PATH=/home/ubuntu/dealsourcing_agent/venv/bin"
ExecStart=/home/ubuntu/dealsourcing_agent/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8002

[Install]
WantedBy=multi-user.target
